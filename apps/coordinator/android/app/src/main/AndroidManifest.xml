<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Esplora lookups and broadcasting. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scanning the signers' QR codes. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Receiving data over sound (the user presses "Listen"). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:label="Minifrost Coordinator"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hasCode="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- Every configuration change is handled in place: the native UI can't be restarted
             (see MinifrostActivity.onDestroy). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|fontWeightAdjustment|locale|layoutDirection|colorMode|navigation|touchscreen|mcc|mnc"
            android:windowSoftInputMode="adjustResize">
            <!-- The UI: libminifrost_coordinator_app (apps/coordinator), started by NativeActivity. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="minifrost_coordinator_app" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
